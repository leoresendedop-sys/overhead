{
  "name": "overhead-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Overhead card for Hermes Desktop: a before/after swipe slider with a change overlay for overhead_compare, and a frame player with a chart for overhead_timelapse.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests-js/lib.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/plugin.tsx --bundle --format=esm --platform=browser --jsx=automatic --minify --legal-comments=none --external:@hermes/plugin-sdk --external:react --external:react/jsx-runtime --outfile=desktop/plugin.js"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "esbuild": "0.28.1",
    "typescript": "5.9.2"
  }
}
